# Copy to red/red.env (gitignored).
# CAI talks to the local Ollama over the internal llm-red network.
# Check CAI's .env docs for the exact variable names in your pinned version.

OLLAMA_API_BASE=http://ollama:11434/v1
CAI_MODEL=ollama/qwen2.5-coder:7b

# Scope: agents may only target hosts on arena-net.
# Targets: juice-shop:3000  dvwa:80
CAI_TRACING=false
